{
  "$description": "Global primitives shared across all brands. Never use directly in components — reference via semantic tokens. Spacing keys = rem × 100 (e.g. 50 = 0.5rem = 8px).",

  "spacing": {
    "0":   { "$value": "0px",    "$type": "dimension" },
    "25":  { "$value": "4px",    "$type": "dimension" },
    "50":  { "$value": "8px",    "$type": "dimension" },
    "75":  { "$value": "12px",   "$type": "dimension" },
    "100": { "$value": "16px",   "$type": "dimension" },
    "125": { "$value": "20px",   "$type": "dimension" },
    "150": { "$value": "24px",   "$type": "dimension" },
    "200": { "$value": "32px",   "$type": "dimension" },
    "250": { "$value": "40px",   "$type": "dimension" },
    "300": { "$value": "48px",   "$type": "dimension" },
    "400": { "$value": "64px",   "$type": "dimension" },
    "500": { "$value": "80px",   "$type": "dimension" },
    "600": { "$value": "96px",   "$type": "dimension" },
    "800": { "$value": "128px",  "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0px",    "$type": "dimension" },
    "1":    { "$value": "2px",    "$type": "dimension" },
    "2":    { "$value": "4px",    "$type": "dimension" },
    "3":    { "$value": "6px",    "$type": "dimension" },
    "4":    { "$value": "8px",    "$type": "dimension" },
    "6":    { "$value": "12px",   "$type": "dimension" },
    "8":    { "$value": "16px",   "$type": "dimension" },
    "12":   { "$value": "24px",   "$type": "dimension" },
    "16":   { "$value": "32px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },

  "font-size": {
    "10": { "$value": "10px", "$type": "dimension" },
    "11": { "$value": "11px", "$type": "dimension" },
    "12": { "$value": "12px", "$type": "dimension" },
    "13": { "$value": "13px", "$type": "dimension" },
    "14": { "$value": "14px", "$type": "dimension" },
    "15": { "$value": "15px", "$type": "dimension" },
    "16": { "$value": "16px", "$type": "dimension" },
    "18": { "$value": "18px", "$type": "dimension" },
    "20": { "$value": "20px", "$type": "dimension" },
    "22": { "$value": "22px", "$type": "dimension" },
    "24": { "$value": "24px", "$type": "dimension" },
    "28": { "$value": "28px", "$type": "dimension" },
    "32": { "$value": "32px", "$type": "dimension" },
    "36": { "$value": "36px", "$type": "dimension" },
    "40": { "$value": "40px", "$type": "dimension" },
    "48": { "$value": "48px", "$type": "dimension" },
    "56": { "$value": "56px", "$type": "dimension" },
    "64": { "$value": "64px", "$type": "dimension" },
    "72": { "$value": "72px", "$type": "dimension" }
  },

  "font-weight": {
    "regular":   { "$value": 400, "$type": "fontWeight" },
    "medium":    { "$value": 500, "$type": "fontWeight" },
    "semibold":  { "$value": 600, "$type": "fontWeight" },
    "bold":      { "$value": 700, "$type": "fontWeight" },
    "extrabold": { "$value": 800, "$type": "fontWeight" }
  },

  "line-height": {
    "none":    { "$value": 1,    "$type": "number" },
    "tight":   { "$value": 1.15, "$type": "number" },
    "snug":    { "$value": 1.3,  "$type": "number" },
    "normal":  { "$value": 1.5,  "$type": "number" },
    "relaxed": { "$value": 1.65, "$type": "number" },
    "loose":   { "$value": 1.8,  "$type": "number" }
  },

  "letter-spacing": {
    "tighter": { "$value": "-0.04em", "$type": "dimension" },
    "tight":   { "$value": "-0.02em", "$type": "dimension" },
    "normal":  { "$value": "0em",     "$type": "dimension" },
    "wide":    { "$value": "0.04em",  "$type": "dimension" },
    "wider":   { "$value": "0.08em",  "$type": "dimension" },
    "widest":  { "$value": "0.16em",  "$type": "dimension" }
  },

  "border-width": {
    "0": { "$value": "0px", "$type": "dimension" },
    "1": { "$value": "1px", "$type": "dimension" },
    "2": { "$value": "2px", "$type": "dimension" },
    "4": { "$value": "4px", "$type": "dimension" }
  },

  "z-index": {
    "0":       { "$value": 0,   "$type": "number" },
    "10":      { "$value": 10,  "$type": "number" },
    "20":      { "$value": 20,  "$type": "number" },
    "30":      { "$value": 30,  "$type": "number" },
    "40":      { "$value": 40,  "$type": "number" },
    "50":      { "$value": 50,  "$type": "number" },
    "modal":   { "$value": 100, "$type": "number" },
    "toast":   { "$value": 200, "$type": "number" },
    "tooltip": { "$value": 300, "$type": "number" }
  },

  "duration": {
    "instant": { "$value": "0ms",   "$type": "duration" },
    "fast":    { "$value": "100ms", "$type": "duration" },
    "normal":  { "$value": "200ms", "$type": "duration" },
    "slow":    { "$value": "300ms", "$type": "duration" },
    "slower":  { "$value": "500ms", "$type": "duration" }
  },

  "easing": {
    "default": { "$value": "ease",                             "$type": "cubicBezier" },
    "in":      { "$value": "ease-in",                          "$type": "cubicBezier" },
    "out":     { "$value": "ease-out",                         "$type": "cubicBezier" },
    "in-out":  { "$value": "ease-in-out",                      "$type": "cubicBezier" },
    "spring":  { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" }
  }
}
