      },
      "content-foreground": {
        "$value": "{color.text.secondary}",
        "$type": "color"
      },
      "background-hover": {
        "$value": "{color.background.subtle}",
        "$type": "color"
      },
      "focus-ring": {
        "$value": "{color.border.focus}",
        "$type": "color"
      },
      "icon-size": {
        "$value": "{typography.size.lg}",
