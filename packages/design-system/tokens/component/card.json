{
  "$description": "Card component tokens.",

  "component": {
    "card": {
      "background":       { "$value": "{color.background.surface}",    "$type": "color" },
      "background-hover": { "$value": "{color.background.elevated}",   "$type": "color" },
      "border":           { "$value": "{color.border.subtle}",         "$type": "color" },
      "border-hover":     { "$value": "{color.border.default}",        "$type": "color" },
      "border-width":     { "$value": "{border-width.1}",              "$type": "dimension" },
      "border-radius":    { "$value": "{border-radius.lg}",            "$type": "dimension" },
      "shadow":           { "$value": "{shadow.sm}",                   "$type": "shadow" },
      "shadow-hover":     { "$value": "{shadow.md}",                   "$type": "shadow" },

      "padding":          { "$value": "{spacing.component.150}",        "$type": "dimension" },
      "gap":              { "$value": "{spacing.component.75}",        "$type": "dimension" },

      "title-font-family":  { "$value": "{typography.font-family.display}", "$type": "fontFamily" },
      "title-font-size":    { "$value": "{typography.size.lg}",             "$type": "dimension" },
      "title-font-weight":  { "$value": "{typography.weight.heading}",      "$type": "fontWeight" },
      "title-color":        { "$value": "{color.text.primary}",             "$type": "color" },
      "title-line-height":  { "$value": "{typography.line-height.heading}",  "$type": "number" },

      "body-font-family":   { "$value": "{typography.font-family.base}", "$type": "fontFamily" },
      "body-font-size":     { "$value": "{typography.size.md}",          "$type": "dimension" },
      "body-font-weight":   { "$value": "{typography.weight.body}",      "$type": "fontWeight" },
      "body-color":         { "$value": "{color.text.secondary}",        "$type": "color" },
      "body-line-height":   { "$value": "{typography.line-height.body}",  "$type": "number" },

      "meta-font-size":     { "$value": "{typography.size.xs}",          "$type": "dimension" },
      "meta-color":         { "$value": "{color.text.tertiary}",         "$type": "color" },

      "divider-color":      { "$value": "{color.border.subtle}",         "$type": "color" },

      "transition-duration":{ "$value": "{motion.duration.normal}",      "$type": "duration" },
      "transition-easing":  { "$value": "{motion.easing.default}",       "$type": "cubicBezier" }
    }
  }
}
