{
  "$description": "Navigation component tokens — top nav bar and nav items.",

  "component": {
    "nav": {
      "background":      { "$value": "{color.background.surface}",   "$type": "color" },
      "border":          { "$value": "{color.border.subtle}",        "$type": "color" },
      "border-width":    { "$value": "{border-width.1}",             "$type": "dimension" },
      "height":          { "$value": "{spacing.300}",                 "$type": "dimension" },
      "padding-x":       { "$value": "{spacing.layout.100}",          "$type": "dimension" },
      "shadow":          { "$value": "{shadow.sm}",                  "$type": "shadow" },

      "logo-font-family":  { "$value": "{typography.font-family.display}", "$type": "fontFamily" },
      "logo-font-size":    { "$value": "{typography.size.lg}",             "$type": "dimension" },
      "logo-font-weight":  { "$value": "{typography.weight.display}",      "$type": "fontWeight" },
      "logo-color":        { "$value": "{color.text.primary}",             "$type": "color" },

      "item": {
        "foreground":        { "$value": "{color.text.secondary}",        "$type": "color" },
        "foreground-hover":  { "$value": "{color.text.primary}",          "$type": "color" },
        "foreground-active": { "$value": "{color.action.background}",     "$type": "color" },
        "background-hover":  { "$value": "{color.background.subtle}",     "$type": "color" },
        "background-active": { "$value": "{color.action.background-subtle}", "$type": "color" },
        "border-radius":     { "$value": "{border-radius.control}",            "$type": "dimension" },
        "padding-x":         { "$value": "{spacing.component.75}",        "$type": "dimension" },
        "padding-y":         { "$value": "{spacing.component.50}",        "$type": "dimension" },
        "font-family":       { "$value": "{typography.font-family.base}",  "$type": "fontFamily" },
        "font-size":         { "$value": "{typography.size.sm}",           "$type": "dimension" },
        "font-weight":       { "$value": "{typography.weight.emphasis}",   "$type": "fontWeight" },
        "letter-spacing":    { "$value": "{typography.letter-spacing.label}", "$type": "dimension" },
        "gap":               { "$value": "{spacing.component.50}",         "$type": "dimension" },
        "transition-duration":{ "$value": "{motion.duration.fast}",        "$type": "duration" }
      },

      "indicator": {
        "color":  { "$value": "{color.action.background}", "$type": "color" },
        "height": { "$value": "{border-width.2}",          "$type": "dimension" }
      }
    }
  }
}
