{
  "$description": "Callout and pull quote tokens.",
  "component": {
    "callout": {
      "border-radius": {
        "$value": "{border-radius.control}",
        "$type": "dimension"
      },
      "padding-x": {
        "$value": "{spacing.component.150}",
        "$type": "dimension"
      },
      "padding-y": {
        "$value": "{spacing.component.100}",
        "$type": "dimension"
      },
      "gap": {
        "$value": "{spacing.component.50}",
        "$type": "dimension"
      },
      "label-font-size": {
        "$value": "{typography.size.xs}",
        "$type": "dimension"
      },
      "label-font-weight": {
        "$value": "{typography.weight.heading}",
        "$type": "fontWeight"
      },
      "neutral": {
        "background": {
          "$value": "{color.background.subtle}",
          "$type": "color"
        },
        "border": {
          "$value": "{color.border.default}",
          "$type": "color"
        },
        "label": {
          "$value": "{color.text.tertiary}",
          "$type": "color"
        },
        "foreground": {
          "$value": "{color.text.primary}",
          "$type": "color"
        }
      },
      "accent": {
        "background": {
          "$value": "{color.feedback.info.background}",
          "$type": "color"
        },
        "border": {
          "$value": "{color.feedback.info.border}",
          "$type": "color"
        },
        "label": {
          "$value": "{color.feedback.info.text}",
          "$type": "color"
        },
        "foreground": {
          "$value": "{color.feedback.info.text}",
          "$type": "color"
        }
      }
    },
    "pull-quote": {
      "rule": {
        "$value": "{color.border.emphasis}",
        "$type": "color"
      },
      "rule-width": {
        "$value": "{border-width.2}",
        "$type": "dimension"
      },
      "padding-x": {
        "$value": "{spacing.component.150}",
        "$type": "dimension"
      },
      "padding-y": {
        "$value": "{spacing.component.100}",
        "$type": "dimension"
      },
      "gap": {
        "$value": "{spacing.component.75}",
        "$type": "dimension"
      },
      "foreground": {
        "$value": "{color.text.primary}",
        "$type": "color"
      },
      "font-size": {
        "$value": "{typography.size.2xl}",
        "$type": "dimension"
      },
      "font-weight": {
        "$value": "{typography.weight.emphasis}",
        "$type": "fontWeight"
      },
      "attribution-foreground": {
        "$value": "{color.text.secondary}",
        "$type": "color"
      },
      "attribution-font-size": {
        "$value": "{typography.size.sm}",
        "$type": "dimension"
      }
    }
  }
}
