{
  "$description": "Button component tokens. All values reference semantic tokens — never primitives.",

  "component": {
    "button": {
      "primary": {
        "background":          { "$value": "{color.action.background}",          "$type": "color" },
        "background-hover":    { "$value": "{color.action.background-hover}",    "$type": "color" },
        "background-active":   { "$value": "{color.action.background-active}",   "$type": "color" },
        "background-disabled": { "$value": "{color.action.background-disabled}", "$type": "color" },
        "foreground":          { "$value": "{color.action.foreground}",          "$type": "color" },
        "foreground-disabled": { "$value": "{color.action.foreground-disabled}", "$type": "color" },
        "border":              { "$value": "{color.action.border}",              "$type": "color" },
        "border-width":        { "$value": "{border-width.1}",                   "$type": "dimension" },
        "border-radius":       { "$value": "{border-radius.md}",                 "$type": "dimension" },
        "padding-x":           { "$value": "{spacing.component.lg}",             "$type": "dimension" },
        "padding-y":           { "$value": "{spacing.component.sm}",             "$type": "dimension" },
        "font-family":         { "$value": "{typography.font-family.base}",      "$type": "fontFamily" },
        "font-size":           { "$value": "{typography.size.md}",               "$type": "dimension" },
        "font-weight":         { "$value": "{typography.weight.emphasis}",       "$type": "fontWeight" },
        "letter-spacing":      { "$value": "{typography.letter-spacing.label}",  "$type": "dimension" },
        "shadow-focus":        { "$value": "{shadow.focus}",                     "$type": "shadow" },
        "transition-duration": { "$value": "{motion.duration.fast}",             "$type": "duration" },
        "transition-easing":   { "$value": "{motion.easing.default}",            "$type": "cubicBezier" }
      },
      "secondary": {
        "background":          { "$value": "{color.action.background-subtle}",   "$type": "color" },
        "background-hover":    { "$value": "{color.action.background-subtle}",   "$type": "color" },
        "background-active":   { "$value": "{color.action.background-subtle}",   "$type": "color" },
        "background-disabled": { "$value": "{color.background.subtle}",          "$type": "color" },
        "foreground":          { "$value": "{color.action.border}",              "$type": "color" },
        "foreground-disabled": { "$value": "{color.action.foreground-disabled}", "$type": "color" },
        "border":              { "$value": "{color.action.border}",              "$type": "color" },
        "border-hover":        { "$value": "{color.action.border-hover}",        "$type": "color" },
        "border-width":        { "$value": "{border-width.1}",                   "$type": "dimension" },
        "border-radius":       { "$value": "{border-radius.md}",                 "$type": "dimension" },
        "padding-x":           { "$value": "{spacing.component.lg}",             "$type": "dimension" },
        "padding-y":           { "$value": "{spacing.component.sm}",             "$type": "dimension" },
        "font-family":         { "$value": "{typography.font-family.base}",      "$type": "fontFamily" },
        "font-size":           { "$value": "{typography.size.md}",               "$type": "dimension" },
        "font-weight":         { "$value": "{typography.weight.emphasis}",       "$type": "fontWeight" },
        "letter-spacing":      { "$value": "{typography.letter-spacing.label}",  "$type": "dimension" }
      },
      "ghost": {
        "background":          { "$value": "{color.background.canvas}",          "$type": "color" },
        "background-hover":    { "$value": "{color.background.subtle}",          "$type": "color" },
        "background-active":   { "$value": "{color.background.subtle}",          "$type": "color" },
        "background-disabled": { "$value": "{color.background.canvas}",          "$type": "color" },
        "foreground":          { "$value": "{color.text.primary}",               "$type": "color" },
        "foreground-disabled": { "$value": "{color.text.disabled}",              "$type": "color" },
        "border":              { "$value": "{color.background.canvas}",          "$type": "color" },
        "border-width":        { "$value": "{border-width.0}",                   "$type": "dimension" },
        "border-radius":       { "$value": "{border-radius.md}",                 "$type": "dimension" },
        "padding-x":           { "$value": "{spacing.component.lg}",             "$type": "dimension" },
        "padding-y":           { "$value": "{spacing.component.sm}",             "$type": "dimension" },
        "font-family":         { "$value": "{typography.font-family.base}",      "$type": "fontFamily" },
        "font-size":           { "$value": "{typography.size.md}",               "$type": "dimension" },
        "font-weight":         { "$value": "{typography.weight.emphasis}",       "$type": "fontWeight" },
        "letter-spacing":      { "$value": "{typography.letter-spacing.label}",  "$type": "dimension" }
      },
      "destructive": {
        "background":          { "$value": "{color.feedback.error.border}",      "$type": "color" },
        "background-hover":    { "$value": "{color.feedback.error.icon}",        "$type": "color" },
        "foreground":          { "$value": "{color.text.inverse}",               "$type": "color" },
        "border":              { "$value": "{color.feedback.error.border}",      "$type": "color" },
        "border-width":        { "$value": "{border-width.1}",                   "$type": "dimension" },
        "border-radius":       { "$value": "{border-radius.md}",                 "$type": "dimension" },
        "padding-x":           { "$value": "{spacing.component.lg}",             "$type": "dimension" },
        "padding-y":           { "$value": "{spacing.component.sm}",             "$type": "dimension" },
        "font-family":         { "$value": "{typography.font-family.base}",      "$type": "fontFamily" },
        "font-size":           { "$value": "{typography.size.md}",               "$type": "dimension" },
        "font-weight":         { "$value": "{typography.weight.emphasis}",       "$type": "fontWeight" }
      },
      "size": {
        "sm": {
          "padding-x":  { "$value": "{spacing.component.md}", "$type": "dimension" },
          "padding-y":  { "$value": "{spacing.component.xs}", "$type": "dimension" },
          "font-size":  { "$value": "{typography.size.sm}",   "$type": "dimension" }
        },
        "lg": {
          "padding-x":  { "$value": "{spacing.component.xl}", "$type": "dimension" },
          "padding-y":  { "$value": "{spacing.component.md}", "$type": "dimension" },
          "font-size":  { "$value": "{typography.size.lg}",   "$type": "dimension" }
        }
      }
    }
  }
}
