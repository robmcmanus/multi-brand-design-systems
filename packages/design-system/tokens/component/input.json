{
  "$description": "Input field component tokens — text input, textarea, select.",

  "component": {
    "input": {
      "background":            { "$value": "{color.background.surface}",        "$type": "color" },
      "background-focus":      { "$value": "{color.background.surface}",        "$type": "color" },
      "background-disabled":   { "$value": "{color.background.subtle}",         "$type": "color" },
      "background-error":      { "$value": "{color.feedback.error.background}", "$type": "color" },

      "foreground":            { "$value": "{color.text.primary}",              "$type": "color" },
      "foreground-placeholder":{ "$value": "{color.text.tertiary}",             "$type": "color" },
      "foreground-disabled":   { "$value": "{color.text.disabled}",             "$type": "color" },

      "border":                { "$value": "{color.border.default}",            "$type": "color" },
      "border-hover":          { "$value": "{color.border.strong}",             "$type": "color" },
      "border-focus":          { "$value": "{color.border.focus}",              "$type": "color" },
      "border-error":          { "$value": "{color.feedback.error.border}",     "$type": "color" },
      "border-disabled":       { "$value": "{color.border.subtle}",             "$type": "color" },
      "border-width":          { "$value": "{border-width.1}",                  "$type": "dimension" },
      "border-radius":         { "$value": "{border-radius.control}",                "$type": "dimension" },

      "padding-x":             { "$value": "{spacing.component.75}",            "$type": "dimension" },
      "padding-y":             { "$value": "{spacing.component.75}",            "$type": "dimension" },
      "gap":                   { "$value": "{spacing.component.50}",            "$type": "dimension" },

      "font-family":           { "$value": "{typography.font-family.base}",     "$type": "fontFamily" },
      "font-size":             { "$value": "{typography.size.md}",              "$type": "dimension" },
      "font-weight":           { "$value": "{typography.weight.body}",          "$type": "fontWeight" },
      "line-height":           { "$value": "{line-height.normal}",   "$type": "number" },

      "shadow-focus":          { "$value": "{shadow.focus}",                    "$type": "shadow" },
      "transition-duration":   { "$value": "{motion.duration.fast}",            "$type": "duration" },

      "label-font-size":       { "$value": "{typography.size.sm}",              "$type": "dimension" },
      "label-font-weight":     { "$value": "{typography.weight.emphasis}",      "$type": "fontWeight" },
      "label-color":           { "$value": "{color.text.secondary}",            "$type": "color" },
      "label-gap":             { "$value": "{spacing.component.50}",            "$type": "dimension" },

      "helper-font-size":      { "$value": "{typography.size.xs}",              "$type": "dimension" },
      "helper-color":          { "$value": "{color.text.tertiary}",             "$type": "color" },
      "error-color":           { "$value": "{color.feedback.error.text}",       "$type": "color" },

      "icon-color":            { "$value": "{color.text.tertiary}",             "$type": "color" },
      "icon-size":             { "$value": "{typography.size.md}",              "$type": "dimension" }
    }
  }
}
