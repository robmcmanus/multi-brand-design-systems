{
  "$description": "List component tokens — simple list and detailed list (with description, metadata).",

  "component": {
    "list": {
      "background":         { "$value": "{color.background.surface}",  "$type": "color" },
      "border-radius":      { "$value": "{border-radius.lg}",          "$type": "dimension" },
      "border":             { "$value": "{color.border.subtle}",       "$type": "color" },
      "border-width":       { "$value": "{border-width.1}",            "$type": "dimension" },

      "item": {
        "padding-x":          { "$value": "{spacing.component.lg}",     "$type": "dimension" },
        "padding-y":          { "$value": "{spacing.component.md}",     "$type": "dimension" },
        "background-hover":   { "$value": "{color.background.subtle}",  "$type": "color" },
        "background-active":  { "$value": "{color.action.background-subtle}", "$type": "color" },
        "gap":                { "$value": "{spacing.component.sm}",     "$type": "dimension" },
        "transition-duration":{ "$value": "{motion.duration.fast}",     "$type": "duration" }
      },

      "divider": {
        "color":      { "$value": "{color.border.subtle}",  "$type": "color" },
        "width":      { "$value": "{border-width.1}",       "$type": "dimension" },
        "inset":      { "$value": "{spacing.component.lg}", "$type": "dimension" }
      },

      "label": {
        "font-family":    { "$value": "{typography.font-family.base}",  "$type": "fontFamily" },
        "font-size":      { "$value": "{typography.size.md}",           "$type": "dimension" },
        "font-weight":    { "$value": "{typography.weight.emphasis}",   "$type": "fontWeight" },
        "color":          { "$value": "{color.text.primary}",           "$type": "color" },
        "line-height":    { "$value": "{typography.line-height.body}",   "$type": "number" }
      },

      "description": {
        "font-family":    { "$value": "{typography.font-family.base}",  "$type": "fontFamily" },
        "font-size":      { "$value": "{typography.size.sm}",           "$type": "dimension" },
        "font-weight":    { "$value": "{typography.weight.body}",       "$type": "fontWeight" },
        "color":          { "$value": "{color.text.secondary}",         "$type": "color" },
        "line-height":    { "$value": "{typography.line-height.body}",   "$type": "number" }
      },

      "meta": {
        "font-size":  { "$value": "{typography.size.xs}",  "$type": "dimension" },
        "color":      { "$value": "{color.text.tertiary}", "$type": "color" }
      },

      "icon": {
        "color":  { "$value": "{color.text.tertiary}",   "$type": "color" },
        "size":   { "$value": "{typography.size.lg}",    "$type": "dimension" }
      },

      "trailing": {
        "color":  { "$value": "{color.text.tertiary}",  "$type": "color" },
        "size":   { "$value": "{typography.size.sm}",   "$type": "dimension" }
      },

      "section-header": {
        "font-size":    { "$value": "{typography.size.xs}",              "$type": "dimension" },
        "font-weight":  { "$value": "{typography.weight.heading}",       "$type": "fontWeight" },
        "color":        { "$value": "{color.text.tertiary}",             "$type": "color" },
        "letter-spacing":{ "$value": "{typography.letter-spacing.wider}", "$type": "dimension" },
        "padding-x":    { "$value": "{spacing.component.lg}",            "$type": "dimension" },
        "padding-y":    { "$value": "{spacing.component.xs}",            "$type": "dimension" }
      }
    }
  }
}
