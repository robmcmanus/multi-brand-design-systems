{
  "$description": "Brand 3 dark mode overrides — colour and shadow only. Applied with data-brand=\"3\" data-theme=\"dark\"; everything else comes from brand-3.json.",
  "color": {
    "background": {
      "canvas": { "$value": "{color.void.800}", "$type": "color", "$description": "#091019 — deep space dark" },
      "surface": { "$value": "{color.void.700}", "$type": "color", "$description": "#0D1521 — raised surface" },
      "elevated": { "$value": "{color.slate.800}", "$type": "color", "$description": "#0F1C30 — dropdown, modal" },
      "overlay": { "$value": "#040810BF", "$type": "color", "$description": "Void scrim" },
      "emphasis": { "$value": "{color.cyan.glow}", "$type": "color", "$description": "Cyan emphasis — HUD highlight" },
      "subtle": { "$value": "{color.grid.default-dark}", "$type": "color", "$description": "Faint cyan tint hover" }
    },
    "text": {
      "primary": { "$value": "{color.void.50}", "$type": "color", "$description": "#F0F5FF — cool white" },
      "secondary": { "$value": "{color.slate.300}", "$type": "color" },
      "tertiary": { "$value": "{color.slate.400}", "$type": "color" },
      "disabled": { "$value": "{color.slate.600}", "$type": "color" },
      "inverse": { "$value": "{color.void.850}", "$type": "color", "$description": "Dark text on cyan bg" },
      "on-emphasis": { "$value": "{color.void.850}", "$type": "color" },
      "link": { "$value": "{color.cyan.300}", "$type": "color" },
      "link-hover": { "$value": "{color.cyan.glow}", "$type": "color" },
      "code": { "$value": "{color.cyan.200}", "$type": "color" }
    },
    "border": {
      "subtle": { "$value": "{color.slate.700}", "$type": "color" },
      "default": { "$value": "{color.slate.600}", "$type": "color" },
      "strong": { "$value": "{color.slate.400}", "$type": "color" },
      "emphasis": { "$value": "{color.cyan.400}", "$type": "color" },
      "focus": { "$value": "{color.cyan.glow}", "$type": "color" }
    },
    "action": {
      "background": { "$value": "{color.cyan.400}", "$type": "color", "$description": "Cyan CTA button" },
      "background-hover": { "$value": "{color.cyan.glow}", "$type": "color" },
      "background-active": { "$value": "{color.cyan.500}", "$type": "color" },
      "background-disabled": { "$value": "{color.slate.700}", "$type": "color" },
      "background-subtle": { "$value": "#00C4F014", "$type": "color", "$description": "Ghost/secondary fill" },
      "foreground": { "$value": "{color.void.850}", "$type": "color", "$description": "Dark text on cyan button" },
      "foreground-disabled": { "$value": "{color.slate.500}", "$type": "color" },
      "border": { "$value": "{color.cyan.400}", "$type": "color" },
      "border-hover": { "$value": "{color.cyan.glow}", "$type": "color" }
    },
    "feedback": {
      "success": {
        "background": { "$value": "#00F5A014", "$type": "color" },
        "text": { "$value": "{color.success.400}", "$type": "color" },
        "border": { "$value": "{color.success.500}", "$type": "color" },
        "icon": { "$value": "{color.success.400}", "$type": "color" }
      },
      "warning": {
        "background": { "$value": "#FFAA0014", "$type": "color" },
        "text": { "$value": "{color.warning.400}", "$type": "color" },
        "border": { "$value": "{color.warning.500}", "$type": "color" },
        "icon": { "$value": "{color.warning.400}", "$type": "color" }
      },
      "error": {
        "background": { "$value": "#FF336614", "$type": "color" },
        "text": { "$value": "{color.error.400}", "$type": "color" },
        "border": { "$value": "{color.error.500}", "$type": "color" },
        "icon": { "$value": "{color.error.400}", "$type": "color" }
      },
      "info": {
        "background": { "$value": "#8B5CF614", "$type": "color" },
        "text": { "$value": "{color.purple.300}", "$type": "color" },
        "border": { "$value": "{color.purple.400}", "$type": "color" },
        "icon": { "$value": "{color.purple.400}", "$type": "color" }
      }
    }
  },
  "shadow": {
    "sm": { "$value": "0 1px 4px rgba(0, 0, 0, 0.4)", "$type": "shadow" },
    "md": { "$value": "0 4px 16px rgba(0, 0, 0, 0.5)", "$type": "shadow" },
    "lg": { "$value": "0 8px 32px rgba(0, 0, 0, 0.6)", "$type": "shadow" },
    "glow": { "$value": "0 0 12px rgba(0, 212, 255, 0.3), 0 0 24px rgba(0, 212, 255, 0.12)", "$type": "shadow", "$description": "Cyan glow — HUD active state" },
    "focus": { "$value": "0 0 0 1px rgba(0, 212, 255, 0.8), 0 0 8px rgba(0, 212, 255, 0.3)", "$type": "shadow", "$description": "Cyan focus — sharp ring + soft glow" }
  }
}
