{
  "$description": "Brand 2 dark mode overrides — applied on top of brand-2.json when [data-brand='2'][data-mode='dark']. Only overrides tokens that change; everything else inherits from brand-2.",

  "color": {
    "background": {
      "canvas":   { "$value": "{color.neutral.900}", "$type": "color", "$description": "#1C1C1C — near-black canvas" },
      "surface":  { "$value": "{color.neutral.800}", "$type": "color", "$description": "Slightly lighter dark for cards" },
      "elevated": { "$value": "{color.neutral.700}", "$type": "color", "$description": "Dropdowns, modals" },
      "overlay":  { "$value": "#111110CC", "$type": "color" },
      "emphasis": { "$value": "{color.yellow.500}",  "$type": "color", "$description": "Yellow emphasis on dark — inverted" },
      "subtle":   { "$value": "{color.neutral.800}", "$type": "color" }
    },
    "text": {
      "primary":     { "$value": "{color.neutral.50}",  "$type": "color", "$description": "#F5F2EB — cream on dark" },
      "secondary":   { "$value": "{color.neutral.300}", "$type": "color" },
      "tertiary":    { "$value": "{color.neutral.400}", "$type": "color" },
      "disabled":    { "$value": "{color.neutral.600}", "$type": "color" },
      "inverse":     { "$value": "{color.neutral.900}", "$type": "color", "$description": "Near-black on cream" },
      "on-emphasis": { "$value": "{color.neutral.900}", "$type": "color", "$description": "Dark text on yellow emphasis" },
      "link":        { "$value": "{color.blue.300}",    "$type": "color" },
      "link-hover":  { "$value": "{color.blue.200}",    "$type": "color" },
      "code":        { "$value": "{color.neutral.300}", "$type": "color" }
    },
    "border": {
      "subtle":   { "$value": "{color.neutral.800}", "$type": "color" },
      "default":  { "$value": "{color.neutral.700}", "$type": "color" },
      "strong":   { "$value": "{color.neutral.500}", "$type": "color" },
      "emphasis": { "$value": "{color.yellow.500}",  "$type": "color" },
      "focus":    { "$value": "{color.yellow.400}",  "$type": "color" }
    },
    "action": {
      "background":          { "$value": "{color.yellow.500}",   "$type": "color" },
      "background-hover":    { "$value": "{color.yellow.400}",   "$type": "color" },
      "background-active":   { "$value": "{color.yellow.600}",   "$type": "color" },
      "background-disabled": { "$value": "{color.neutral.700}",  "$type": "color" },
      "background-subtle":   { "$value": "#F7CA421A", "$type": "color" },
      "foreground":          { "$value": "{color.neutral.900}",  "$type": "color" },
      "foreground-disabled": { "$value": "{color.neutral.500}",  "$type": "color" },
      "border":              { "$value": "{color.yellow.500}",   "$type": "color" },
      "border-hover":        { "$value": "{color.yellow.400}",   "$type": "color" }
    },
    "feedback": {
      "success": {
        "background": { "$value": "#2B6AAD1F", "$type": "color" },
        "text":       { "$value": "{color.blue.300}", "$type": "color" },
        "border":     { "$value": "{color.blue.400}", "$type": "color" },
        "icon":       { "$value": "{color.blue.300}", "$type": "color" }
      },
      "warning": {
        "background": { "$value": "#F7CA421F", "$type": "color" },
        "text":       { "$value": "{color.yellow.300}",         "$type": "color" },
        "border":     { "$value": "{color.yellow.400}",         "$type": "color" },
        "icon":       { "$value": "{color.yellow.300}",         "$type": "color" }
      },
      "error": {
        "background": { "$value": "#D448301F", "$type": "color" },
        "text":       { "$value": "{color.red.300}",            "$type": "color" },
        "border":     { "$value": "{color.red.400}",            "$type": "color" },
        "icon":       { "$value": "{color.red.300}",            "$type": "color" }
      },
      "info": {
        "background": { "$value": "#2B6AAD1F", "$type": "color" },
        "text":       { "$value": "{color.blue.300}", "$type": "color" },
        "border":     { "$value": "{color.blue.400}", "$type": "color" },
        "icon":       { "$value": "{color.blue.300}", "$type": "color" }
      }
    }
  },

  "shadow": {
    "sm":    { "$value": "0 1px 3px rgba(0, 0, 0, 0.4)",                        "$type": "shadow" },
    "md":    { "$value": "0 4px 16px rgba(0, 0, 0, 0.5)",                       "$type": "shadow" },
    "lg":    { "$value": "0 16px 48px rgba(0, 0, 0, 0.6)",                      "$type": "shadow" },
    "focus": { "$value": "0 0 0 3px rgba(247, 202, 66, 0.45)",                  "$type": "shadow" }
  }
}
